---
// Design preview only: the proposed new direction for the home page. Not linked from the site.
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/instrument-sans/index.css';
import { products, SEASONS, TYPES, inSeason, ofType, season as seasonOf } from '../lib/catalog';

const find = (seasonKey: string, code: string) => {
  const p = products.find((x) => x.season === seasonKey && x.code === code);
  if (!p) throw new Error(`${seasonKey} ${code}`);
  return p;
};
const cut = (seasonKey: string, code: string) => `/images/cutouts/${seasonKey}-${code}.webp`;

const tiles = [
  { key: 'spring', code: 'C295', bg: '#ffd84d', fg: '#3a1030' },
  { key: 'easter', code: 'F69', bg: '#c9b6f2', fg: '#2a1a57' },
  { key: 'patriotic', code: 'G17', bg: '#bcdcf5', fg: '#10295f' },
  { key: 'harvest', code: 'H35', bg: '#123f2d', fg: '#fff3d6' },
  { key: 'halloween', code: 'G35', bg: '#ff6a13', fg: '#150d05' },
  { key: 'christmas', code: 'S142', bg: '#f6efe2', fg: '#9c1420' },
];

const typeImg: Record<string, [string, string]> = {
  wreath: ['harvest', 'H37'],
  garland: ['christmas', 'S135'],
  stem: ['harvest', 'H36'],
  arrangement: ['spring', 'C399'],
  bouquet: ['spring', 'C309'],
  tree: ['christmas', 'S70'],
  decor: ['harvest', 'H42'],
};

const stems: [string, string, string][] = [
  ['harvest', 'H36', 'Maple branch'],
  ['christmas', 'S141', 'Cedar pick'],
  ['harvest', 'H05', 'Dusky leaf branch'],
  ['spring', 'C334', 'Blossom branch'],
  ['christmas', 'S12', 'Long-needle pine pick'],
];

const ways = [
  { code: 'C345', name: 'Pink', swatch: '#ee7fa6', bg: '#fde6ee' },
  { code: 'C346', name: 'Blue', swatch: '#4a8fdc', bg: '#e1eefb' },
  { code: 'C347', name: 'White', swatch: '#f4f1e8', bg: '#eef1ea' },
  { code: 'C348', name: 'Yellow', swatch: '#f5c518', bg: '#fdf3c9' },
];

const shelf: [string, string][] = [
  ['halloween', 'G09'], ['easter', 'F19'], ['harvest', 'H82'], ['spring', 'C273'],
  ['patriotic', 'G05'], ['halloween', 'G38'], ['harvest', 'H88'], ['spring', 'C276'],
];
const longest = Math.max(...products.map((p) => p.size?.inches ?? 0));
const smallest = Math.min(...products.map((p) => p.size?.inches ?? Infinity));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Kexinda design preview</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<style is:global>
:root {
  --bg: #fffdf7; --panel: #f4f0e4; --ink: #15221a; --ink2: #56605a; --line: #e2dccb;
  --green: #0f5c3a; --green-d: #0b3f29; --lime: #dbe96e;
  --display: 'Bricolage Grotesque Variable', system-ui, sans-serif;
  --body: 'Instrument Sans Variable', system-ui, sans-serif;
  --g: clamp(16px, 3vw, 44px);
}
*,*::before,*::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.5 var(--body); -webkit-font-smoothing: antialiased; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, p, ul, ol, figure { margin: 0; padding: 0; list-style: none; }
h1, h2, h3, .big { font-family: var(--display); font-weight: 700; letter-spacing: -0.035em; line-height: 0.98; }
h2 { font-size: clamp(2.3rem, 5.2vw, 4.8rem); text-wrap: balance; }
:focus-visible { outline: 3px solid var(--green); outline-offset: 2px; }
button { font: inherit; color: inherit; cursor: pointer; }
.wrap { max-width: 1560px; margin-inline: auto; padding-inline: var(--g); }
.sec { padding-block: clamp(56px, 8vw, 112px); }
.pill { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 26px; border-radius: 99px; background: var(--green); color: #fff; font-weight: 600; border: 2px solid var(--green); transition: background-color .2s, transform .2s; }
.pill:hover { background: var(--green-d); border-color: var(--green-d); transform: translateY(-2px); }
.pill.ghost { background: transparent; color: var(--ink); border-color: var(--ink); }
.pill.ghost:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
.pill.lime { background: var(--lime); border-color: var(--lime); color: var(--green-d); }
.pill.lime:hover { background: #fff; border-color: #fff; }

.head { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(12px); }
.head .wrap { display: flex; align-items: center; gap: clamp(14px, 2.6vw, 36px); height: 72px; }
.logo { display: inline-flex; align-items: center; gap: 9px; margin-right: auto; font: 800 1.5rem var(--display); letter-spacing: -0.04em; }
.logo svg { width: 24px; height: 24px; }
.nav { display: flex; gap: clamp(14px, 2vw, 30px); font-weight: 500; }
.nav a:hover { color: var(--green); }
.list-btn { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 8px 0 18px; border-radius: 99px; background: var(--ink); color: #fff; font-weight: 600; font-size: .95rem; white-space: nowrap; }
.list-btn i { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--lime); color: var(--ink); font-style: normal; font-size: .85rem; }

.hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); min-height: calc(100svh - 72px); }
.hero-text { display: flex; flex-direction: column; justify-content: center; gap: 24px; padding: 24px clamp(20px, 3.5vw, 56px) 40px var(--g); }
.eyebrow { font-weight: 600; color: var(--green); }
h1 { font-size: clamp(3rem, 6.1vw, 6.7rem); line-height: 0.93; letter-spacing: -0.045em; font-weight: 800; }
h1 span { display: block; color: var(--green); }
.hero-text p.sub { font-size: clamp(1.08rem, 1.35vw, 1.25rem); color: var(--ink2); max-width: 30em; text-wrap: pretty; }
.cta-row { display: flex; gap: 10px; flex-wrap: wrap; }
.board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: 1fr 1fr; }
.tile { position: relative; overflow: hidden; color: var(--fg); background: var(--bgc); min-height: 280px; }
.tile img { position: absolute; width: 112%; max-width: none; left: 8%; top: 22%; transition: transform .7s cubic-bezier(.2,.7,.2,1); filter: drop-shadow(0 14px 18px rgb(0 0 0 / .22)); }
.tile:hover img, .tile:focus-visible img { transform: rotate(9deg) scale(1.06); }
.tile-label { position: absolute; z-index: 1; left: 18px; top: 14px; }
.tile-label b { display: block; font: 800 clamp(1.5rem, 2.5vw, 2.6rem)/1 var(--display); letter-spacing: -0.04em; }
.tile-label small { font-size: .9rem; font-weight: 600; }

.stats { background: var(--green); color: #fff; }
.stats dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 0; padding-block: 24px; }
.stats dt { font: 800 clamp(1.6rem, 3vw, 2.9rem)/1.05 var(--display); letter-spacing: -0.035em; }
.stats dd { margin: 2px 0 0; opacity: .85; font-size: .95rem; }

.sec-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(24px, 3.4vw, 44px); }
.link { font-weight: 600; border-bottom: 2px solid currentColor; padding-bottom: 2px; }
.link:hover { color: var(--green); }
.bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(220px, 21vw, 320px); gap: 10px; }
.b { position: relative; overflow: hidden; padding: 18px 20px; border-radius: 22px; background: var(--panel); transition: background-color .25s; }
.b:hover { background: var(--lime); }
.b.big-b { grid-column: span 2; grid-row: span 2; }
.b:nth-child(6), .b:nth-child(7) { grid-column: span 2; }
.b:nth-child(6) img, .b:nth-child(7) img { width: 46%; }
.b h3 { font-size: clamp(1.25rem, 1.9vw, 1.85rem); line-height: 1.05; max-width: 11em; position: relative; z-index: 1; }
.b.big-b h3 { font-size: clamp(2rem, 4vw, 3.8rem); }
.b small { position: relative; z-index: 1; color: var(--ink2); font-weight: 600; }
.b img { position: absolute; right: -4%; bottom: -8%; width: 72%; max-height: 80%; object-fit: contain; object-position: right bottom; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
.b.big-b img { width: 84%; max-height: 82%; right: -6%; bottom: -8%; }
.b:hover img { transform: scale(1.05) rotate(-3deg); }

.leaf { background: var(--lime); }
.leaf-intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 18px 40px; align-items: end; }
.leaf-intro p { font-size: clamp(1.08rem, 1.4vw, 1.3rem); text-wrap: pretty; }
.stems { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: clamp(24px, 4vw, 48px); }
.stems a { display: block; }
.stems .s { height: clamp(300px, 36vw, 520px); display: flex; align-items: flex-end; justify-content: center; }
.stems img { max-height: 100%; width: auto; filter: drop-shadow(0 12px 12px rgb(30 50 0 / .22)); transition: transform .5s cubic-bezier(.2,.7,.2,1); transform-origin: bottom center; }
.stems a:hover img { transform: rotate(-3deg) scale(1.03); }
.stems b { display: block; margin-top: 14px; font-weight: 700; line-height: 1.2; }
.stems small { font-size: .9rem; }

.ways { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: center; transition: background-color .35s; background: var(--w); }
.ways-img { padding: clamp(24px, 4vw, 64px); }
.ways-img img { width: min(100%, 620px); margin-inline: auto; filter: drop-shadow(0 18px 22px rgb(0 0 0 / .2)); }
.ways-text { padding: clamp(24px, 4vw, 64px) var(--g) clamp(32px, 4vw, 64px) 0; }
.ways-text p { margin-block: 18px 22px; font-size: clamp(1.08rem, 1.4vw, 1.3rem); max-width: 30em; text-wrap: pretty; }
.sw { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
.sw button { display: inline-flex; align-items: center; gap: 9px; min-height: 48px; padding: 0 18px 0 9px; border: 2px solid transparent; border-radius: 99px; background: #fff; font-weight: 600; }
.sw button i { width: 30px; height: 30px; border-radius: 50%; background: var(--s); box-shadow: inset 0 0 0 1px rgb(0 0 0 / .14); }
.sw button[aria-pressed='true'] { border-color: var(--ink); }
.ways-model { font-weight: 600; color: var(--ink2); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
.chips span { padding: 6px 13px; border: 1.5px solid var(--ink); border-radius: 99px; font-weight: 500; font-size: .95rem; }

.shelf { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px 10px; }
.card { position: relative; display: block; }
.frame { position: relative; aspect-ratio: 1; border-radius: 22px; background: var(--panel); transition: background-color .25s; }
.card:hover .frame { background: var(--tint); }
.frame img { position: absolute; inset: 9%; width: 82%; height: 82%; object-fit: contain; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
.card:hover img { transform: scale(1.05); }
.meta { display: flex; justify-content: space-between; gap: 8px; margin-top: 10px; font-weight: 700; }
.meta span:last-child { font-weight: 500; color: var(--ink2); }
.kind { color: var(--ink2); font-size: .95rem; }
.add { position: absolute; right: 12px; top: 12px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--ink); color: #fff; font-size: 1.4rem; line-height: 1; transition: background-color .2s, transform .2s; }
.add:hover { background: var(--green); transform: scale(1.08); }

.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; counter-reset: s; }
.steps li { padding: 22px; border-radius: 22px; background: var(--panel); counter-increment: s; }
.steps li::before { content: counter(s); display: block; font: 800 clamp(3rem, 6vw, 5.5rem)/1 var(--display); color: var(--green); letter-spacing: -0.05em; margin-bottom: 18px; }
.steps b { display: block; font: 700 clamp(1.3rem, 2vw, 1.8rem)/1.1 var(--display); letter-spacing: -0.03em; margin-bottom: 6px; }
.steps span { color: var(--ink2); }

.end { position: relative; overflow: hidden; background: var(--green-d); color: #fff; }
.end .wrap { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-block: clamp(48px, 7vw, 96px); }
.end h2 { max-width: 13em; }
.foot { background: var(--green-d); color: #cfe0d4; border-top: 1px solid #1f5a41; }
.foot .wrap { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 22px; font-size: .95rem; }
.note { position: fixed; left: 50%; bottom: 72px; translate: -50% 0; z-index: 50; padding: 8px 16px; border-radius: 99px; background: var(--ink); color: #fff; font-size: .85rem; white-space: nowrap; }

@media (max-width: 900px) {
  .nav { display: none; }
  .hero { grid-template-columns: 1fr; min-height: 0; }
  .hero-text { padding: 28px var(--g) 32px; }
  .board { grid-template-columns: 1fr 1fr; grid-template-rows: none; }
  .tile { min-height: 0; aspect-ratio: 1 / 1.2; }
  .tile img { top: 30%; }
  .b:nth-child(6), .b:nth-child(7) { grid-column: span 1; }
  .b:nth-child(6) img, .b:nth-child(7) img { width: 72%; }
  .stats dl { grid-template-columns: 1fr 1fr; }
  .bento { grid-template-columns: 1fr 1fr; grid-auto-rows: 190px; }
  .b.big-b { grid-row: span 2; }
  .leaf-intro, .ways { grid-template-columns: 1fr; }
  .stems { grid-template-columns: repeat(5, 62vw); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 10px; }
  .stems a { scroll-snap-align: start; }
  .ways-text { padding: 0 var(--g) 36px; }
  .shelf { grid-template-columns: 1fr 1fr; }
  .steps { grid-template-columns: 1fr; }
  .note { display: none; }
}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>
</head>
<body>
<header class="head"><div class="wrap">
  <a class="logo" href="/preview-v2/">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 28C4 12 13 4 28 3c0 16-8 25-24 25Z" fill="#0f5c3a"/><path d="M4 28 20 11" stroke="#fffdf7" stroke-width="2" fill="none"/></svg>
    Kexinda
  </a>
  <nav class="nav" aria-label="Main"><a href="/products/">Catalog</a><a href="/customization/">Customization</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
  <a class="list-btn" href="/contact/">Inquiry list <i>0</i></a>
</div></header>

<main>
  <section class="hero">
    <div class="hero-text">
      <span class="eyebrow">Artificial foliage manufacturer &amp; wholesale supplier</span>
      <h1>Inspired by Nature. <span>Made for Your Market.</span></h1>
      <p class="sub">Leaf branches, greenery garlands, wreaths and decorative greenery for wholesalers, importers and distributors.</p>
      <div class="cta-row">
        <a class="pill" href="/products/">Browse {products.length} models</a>
        <a class="pill ghost" href="/contact/">Send an inquiry</a>
      </div>
    </div>
    <nav class="board" aria-label="Seasonal collections">
      {tiles.map((t) => (
        <a class="tile" href={`/collections/${t.key}/`} style={`--bgc:${t.bg};--fg:${t.fg}`}>
          <span class="tile-label"><b>{seasonOf(t.key).name}</b><small>{inSeason(t.key).length} models</small></span>
          <img src={cut(t.key, t.code)} alt={`${seasonOf(t.key).name} wreath, model ${find(t.key, t.code).model}`} width="1000" height="1000" />
        </a>
      ))}
    </nav>
  </section>

  <section class="stats"><div class="wrap"><dl>
    <div><dt>{products.length}</dt><dd>models in the catalog</dd></div>
    <div><dt>{SEASONS.length}</dt><dd>seasonal collections</dd></div>
    <div><dt>{smallest} in – {longest / 12} ft</dt><dd>size range</dd></div>
    <div><dt>On request</dt><dd>custom styles, colors, sizes and packaging</dd></div>
  </dl></div></section>

  <section class="sec wrap">
    <div class="sec-head"><h2>What we make</h2><a class="link" href="/products/">View the full catalog</a></div>
    <div class="bento">
      {TYPES.map((t, i) => {
        const [s, c] = typeImg[t.key];
        return (
          <a class={`b ${i === 0 ? 'big-b' : ''}`} href={`/products/?type=${t.key}`}>
            <h3>{t.name}</h3>
            <small>{ofType(t.key).length} models</small>
            <img src={cut(s, c)} alt="" loading="lazy" />
          </a>
        );
      })}
    </div>
  </section>

  <section class="sec leaf"><div class="wrap">
    <div class="leaf-intro">
      <h2>It starts with the leaf.</h2>
      <p>Foliage is our specialty: individual leaves, leaf branches, greenery garlands and decorative greenery, supplied on their own or built into finished designs.</p>
    </div>
    <div class="stems">
      {stems.map(([s, c, name]) => {
        const p = find(s, c);
        return (
          <a href={`/products/${p.slug}/`}>
            <div class="s"><img src={cut(s, c)} alt={`${name}, model ${p.model}`} loading="lazy" /></div>
            <b>{name}</b>
            <small>{p.model} · {p.size?.label}</small>
          </a>
        );
      })}
    </div>
  </div></section>

  <section class="ways" data-ways style={`--w:${ways[0].bg}`}>
    <div class="ways-img"><img data-way-img src={cut('spring', ways[0].code)} alt={`${ways[0].name} leaf and rose wreath`} width="1000" height="1000" /></div>
    <div class="ways-text">
      <h2>One design. Your colors.</h2>
      <p>Tap a color. This wreath is already in the catalog in all four, and we welcome discussions about the styles, leaf shapes, colors, dimensions and packaging your market needs.</p>
      <div class="sw" role="group" aria-label="Choose a color">
        {ways.map((w, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-way={cut('spring', w.code)} data-bg={w.bg} data-name={w.name} data-model={find('spring', w.code).model} style={`--s:${w.swatch}`}><i></i>{w.name}</button>
        ))}
      </div>
      <span class="ways-model" data-way-model>{find('spring', ways[0].code).model} · 20 in</span>
      <div class="chips"><span>Product styles</span><span>Leaf shapes</span><span>Colors</span><span>Dimensions</span><span>Packaging</span></div>
    </div>
  </section>

  <section class="sec wrap">
    <div class="sec-head"><h2>From the catalog</h2><a class="link" href="/products/">See all {products.length}</a></div>
    <div class="shelf">
      {shelf.map(([s, c]) => {
        const p = find(s, c);
        const tint = tiles.find((t) => t.key === s)!.bg;
        return (
          <div class="card" style={`--tint:${tint}`}>
            <a href={`/products/${p.slug}/`}>
              <div class="frame"><img src={cut(s, c)} alt={`Model ${p.model}`} loading="lazy" /></div>
              <div class="meta"><span>{p.model}</span><span>{p.size?.label}</span></div>
              <div class="kind">{seasonOf(s).name}</div>
            </a>
            <button class="add" type="button" aria-label={`Add ${p.model} to inquiry list`}>+</button>
          </div>
        );
      })}
    </div>
  </section>

  <section class="sec wrap" style="padding-top:0">
    <div class="sec-head"><h2>How to inquire</h2></div>
    <ol class="steps">
      <li><b>Shortlist models</b><span>Press + on any product to add it to your inquiry list as you browse.</span></li>
      <li><b>Send your list</b><span>Add your market, quantities and any changes to color, size or packaging.</span></li>
      <li><b>Talk it through</b><span>We come back to you to discuss your requirements and a quotation.</span></li>
    </ol>
  </section>

  <section class="end"><div class="wrap">
    <h2>Tell us what your market is looking for.</h2>
    <a class="pill lime" href="/contact/">Send an inquiry</a>
  </div></section>
</main>
<footer class="foot"><div class="wrap"><span>Kexinda. Inspired by Nature. Made for Your Market.</span><span>Artificial foliage manufacturer and wholesale supplier, China</span></div></footer>

<script>
  const root = document.querySelector<HTMLElement>('[data-ways]');
  const image = document.querySelector<HTMLImageElement>('[data-way-img]');
  const label = document.querySelector<HTMLElement>('[data-way-model]');
  const buttons = document.querySelectorAll<HTMLElement>('[data-way]');
  buttons.forEach((b) => {
    const pre = new Image();
    pre.src = b.dataset.way!;
    b.addEventListener('click', () => {
      if (!root || !image || !label) return;
      image.src = b.dataset.way!;
      image.alt = `${b.dataset.name} leaf and rose wreath`;
      root.style.setProperty('--w', b.dataset.bg!);
      label.textContent = `${b.dataset.model} · 20 in`;
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    });
  });
</script>
</body>
</html>
