---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <div class="wrap page-intro" style="min-height:50vh">
    <span class="label muted">404</span>
    <h1>This page has gone out of season.</h1>
    <p class="lede" style="margin-bottom:24px">It may have moved, or the link may be mistyped.</p>
    <a class="btn" href="/products/">Browse the catalog</a>
  </div>
</Base>
